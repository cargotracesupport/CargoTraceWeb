# ── Supabase ──────────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. Project Settings → API → service_role secret. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# ── Map tiles (free default) ──────────────────────────────
# Free key from https://www.maptiler.com/
NEXT_PUBLIC_MAPTILER_KEY=your-maptiler-key

# ── Google Maps (optional) ────────────────────────────────
# When set, the app uses Google Maps for display + Google Routes for
# traffic-aware directions/ETAs. When unset, it falls back to MapLibre +
# MapTiler (above) and OSRM. Add the same values in Vercel too.
# Browser key — HTTP-referrer restricted to your domain (Maps JavaScript API):
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
# Map ID for the vector map + custom markers (Google Cloud → Map Management):
NEXT_PUBLIC_GOOGLE_MAP_ID=
# Server-only key for the Routes API. NEVER expose to the browser.
GOOGLE_ROUTES_KEY=

# ── App ───────────────────────────────────────────────────
# Public base URL (used to build customer tracking links). No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000
