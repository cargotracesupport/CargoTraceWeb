# ── Supabase ──────────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. Project Settings → API → service_role secret. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# ── Google Maps (optional) ────────────────────────────────
# When set, the app uses Google Maps for display + Google Routes for
# traffic-aware directions/ETAs. When unset, it falls back to MapLibre +
# MapTiler (above) and OSRM. Add the same values in Vercel too.
# Browser key — HTTP-referrer restricted to your domain (Maps JavaScript API):
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
# Map ID for the vector map + custom markers (Google Cloud → Map Management):
NEXT_PUBLIC_GOOGLE_MAP_ID=
# Server-only key for the Routes API. NEVER expose to the browser.
GOOGLE_ROUTES_KEY=

# ── WhatsApp (optional — automated customer notifications) ─
# Meta Cloud API. When unset, WhatsApp automation is fully inert (nothing sends,
# nothing breaks). Full setup: docs/whatsapp-setup.md. All server-only.
# WhatsApp → API Setup → the sender number's "Phone number ID":
WHATSAPP_PHONE_NUMBER_ID=
# A PERMANENT access token (System User token) — not the 24h test token:
WHATSAPP_ACCESS_TOKEN=
# Shared secret you also put on the Supabase Database Webhook (x-webhook-secret):
WHATSAPP_WEBHOOK_SECRET=
# Country code (digits only) prefixed to bare local customer numbers, e.g. 91 for India:
WHATSAPP_DEFAULT_COUNTRY_CODE=91
# Language code of your approved templates (must match Meta exactly, e.g. en / en_US):
WHATSAPP_TEMPLATE_LANG=en
# Template names — override only if you named them differently in Meta:
# WHATSAPP_TEMPLATE_BOOKED=ct_booked
# WHATSAPP_TEMPLATE_EN_ROUTE=ct_en_route
# WHATSAPP_TEMPLATE_DELIVERED=ct_delivered
# Also auto-send the "booked / set drop-off" message on delivery creation
# (off by default — the manual "Send on WhatsApp" button already covers it):
# WHATSAPP_SEND_ON_BOOKED=true

# ── App ───────────────────────────────────────────────────
# Public base URL (used to build customer tracking links). No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000
